PORT=10000
APP_ENV=production
C33_ROLE=primary
SECRET_KEYS=["replace-with-a-strong-32-byte-or-longer-secret"]
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB
PUBLIC_BASE_URL=https://c33-backend.onrender.com
PEER_BACKEND_URL=https://iac33-backup-production.up.railway.app
PEER_REPLICATION_SECRET=replace-with-a-different-32-byte-or-longer-secret

# Global deadline contract
CLIENT_TIMEOUT_MS=28000
BACKEND_TOTAL_TIMEOUT_MS=26000
NETWORK_TIMEOUT_SECONDS=8

# Resilience policy
LOCAL_FALLBACK_ENABLED=true
REQUIRE_PROVIDER_REDUNDANCY=true
AI_PROVIDER_ORDER=provider_a,provider_b,provider_c
# Each provider must be a separate failure domain where possible.
AI_PROVIDERS_JSON=[{"id":"provider_a","base_url":"https://example-a.example/v1","model":"model-a","api_key_env":"PROVIDER_A_API_KEY","failure_domain":"provider-a","timeout_ms":7500},{"id":"provider_b","base_url":"https://example-b.example/v1","model":"model-b","api_key_env":"PROVIDER_B_API_KEY","failure_domain":"provider-b","timeout_ms":6500},{"id":"provider_c","base_url":"https://example-c.example/v1","model":"model-c","api_key_env":"PROVIDER_C_API_KEY","failure_domain":"provider-c","timeout_ms":5500}]
