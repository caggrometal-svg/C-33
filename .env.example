PORT=10000
APP_ENV=production
C33_ROLE=primary
SECRET_KEYS=["replace-with-a-strong-32-byte-or-longer-secret"]
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB
PUBLIC_BASE_URL=https://iac33-backup-production.up.railway.app
PEER_BACKEND_URL=https://c33-backend.onrender.com
PEER_REPLICATION_SECRET=replace-with-a-different-32-byte-or-longer-secret

CLIENT_TIMEOUT_MS=22000
BACKEND_TOTAL_TIMEOUT_MS=18000
NETWORK_TIMEOUT_SECONDS=8

LOCAL_FALLBACK_ENABLED=true
REQUIRE_PROVIDER_REDUNDANCY=true
AI_PROVIDER_ORDER=kilo,animica,vireonix,blockrun
AI_PROVIDERS_JSON='[{"id":"vireonix","base_url":"https://vireonix.ai/v1","model":"auto","failure_domain":"vireonix.ai","timeout_ms":6000},{"id":"blockrun","base_url":"https://blockrun.ai/api/v1","model":"nvidia/gpt-oss-20b","failure_domain":"blockrun.ai","timeout_ms":4000},{"id":"animica","base_url":"https://animica.dev/v1","model":"kimi-k3","failure_domain":"animica.dev","timeout_ms":5750},{"id":"kilo","base_url":"https://api.kilo.ai/api/gateway","model":"kilo-auto/free","failure_domain":"kilo.ai","timeout_ms":5500}]'


# Optional provider capability tags used by NEXO model selection.
# Example tags: fast, low_latency, reasoning, quality, economical, cheap, local, private.
AI_PROVIDER_A_CAPABILITIES=chat,stream
AI_PROVIDER_B_CAPABILITIES=chat,stream
