PORT=8080
APP_ENV=production
C33_ROLE=primary
SECRET_KEYS=["replace-with-a-strong-secret-at-least-32-characters"]
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB
PUBLIC_BASE_URL=
C33_ALLOWED_HOSTS=*.up.railway.app,*.onrender.com,localhost,127.0.0.1
# Independent peer settings; leave empty until a real C-33 peer is active.
PEER_BACKEND_URL=
PEER_REPLICATION_SECRET=

CLIENT_TIMEOUT_MS=22000
BACKEND_TOTAL_TIMEOUT_MS=18000
NETWORK_TIMEOUT_SECONDS=8

LOCAL_FALLBACK_ENABLED=true
REQUIRE_PROVIDER_REDUNDANCY=true
AI_PROVIDER_ORDER=vireonix,kilo,pollinations
AI_PROVIDERS_JSON='[{"id":"kilo","base_url":"https://api.kilo.ai/api/gateway","model":"kilo-auto/free","failure_domain":"kilo.ai","timeout_ms":4500},{"id":"vireonix","base_url":"https://vireonix.ai/v1","model":"auto","failure_domain":"vireonix.ai","timeout_ms":4500},{"id":"pollinations","base_url":"https://text.pollinations.ai","model":"openai-fast","failure_domain":"pollinations.ai","timeout_ms":10000}]'

# Optional provider capability tags used by NEXO model selection.
AI_PROVIDER_A_CAPABILITIES=chat,stream
AI_PROVIDER_B_CAPABILITIES=chat,stream
